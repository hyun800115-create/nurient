<?xml version="1.0" encoding="utf-8"?>
<!-- 행복한 눈꽃마을 이야기 · Snowbloom Village — Android app (sideloaded test APKs: build_apk.py; Google Play bundles: build_aab.py).
     Template: the build fills in the package, SDK levels, extra permissions and the WebView-debugging flag, then aapt2 links it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="@@PACKAGE@@"
    android:installLocation="auto">

    <uses-sdk android:minSdkVersion="@@MIN_SDK@@" android:targetSdkVersion="@@TARGET_SDK@@" />

    <!-- haptics: the game calls navigator.vibrate (WebView needs this normal, install-time permission for it) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    @@EXTRA_PERMISSIONS@@

    <uses-feature android:glEsVersion="0x00020000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:supportsRtl="false"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true">
        <!-- appCategory="game": Android 16 ignores screenOrientation="portrait" on large screens (smallest width >= 600 dp)
             for targetSdk 36 apps, except games. enableOnBackInvokedCallback="true": back reaches the app through
             MainActivity's OnBackInvokedCallback (Api33) on Android 13+; targetSdk 36 makes that the only route on
             Android 16 anyway (onBackPressed is no longer called there). -->

        <!-- no Safe Browsing lookups and no usage metrics for a game that only shows its own packed files -->
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
        <!-- WebView remote debugging (chrome://inspect over USB): true in the sideloaded test APKs, false in Play builds -->
        <meta-data android:name="com.snowbloom.village.WEB_DEBUG" android:value="@@WEB_DEBUG@@" />

        <activity
            android:name="com.snowbloom.village.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
